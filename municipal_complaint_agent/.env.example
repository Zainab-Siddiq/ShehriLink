# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit. NEVER commit `.env` (it is git-ignored).
# ---------------------------------------------------------------------------

# mock      -> no LLM, deterministic rules (works with NO API key - best for demos)
# openai    -> OpenAI or any OpenAI-compatible server (set LLM_BASE_URL for Groq/OpenRouter/Ollama)
# anthropic -> Claude
# google    -> Gemini (pip install langchain-google-genai)
LLM_PROVIDER=mock

# Leave empty to use a sensible default for the provider.
MODEL_NAME=

API_KEY=

# Optional: OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1 or http://localhost:11434/v1
LLM_BASE_URL=

# Seconds before an LLM call times out (then rule-based fallback is used)
LLM_TIMEOUT=30

# Escalate to a human after this many FAILED verifications
MAX_RETRIES=3

# Default verification mode when the API request does not specify one:
# manual -> complaint stays open (team assigned) until an officer verifies it in the admin page
# success | fail_once | fail_twice | fail_<n> | always_fail -> simulated verification result
VERIFICATION_SCENARIO=manual

# Integrated mode: URL of the Database Backend (cd backend && uvicorn app.main:app --port 8001).
# Leave empty to run the agents alone with the in-memory mock data.
DB_BACKEND_URL=http://localhost:8001

# Capacity assumed for every team when checking availability (the database stores no capacity).
TEAM_CAPACITY=5
